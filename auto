--====================================================
-- DRAWING
--====================================================

local function NewDrawing(Type)

    local Object = Drawing.new(Type)
    Object.Visible = false

    return Object
end

local function CreateESP(Player)

    if Player == LocalPlayer then return end
    if ESPObjects[Player] then return end

    local ESP = {}

    ESP.Box = NewDrawing("Square")
    ESP.Box.Filled = false
    ESP.Box.Thickness = 1.5

    ESP.Line = NewDrawing("Line")
    ESP.Line.Thickness = 1.5

    ESP.Name = NewDrawing("Text")
    ESP.Name.Size = 14
    ESP.Name.Center = true
    ESP.Name.Outline = true

    ESP.Health = NewDrawing("Text")
    ESP.Health.Size = 13
    ESP.Health.Center = true
    ESP.Health.Outline = true

    ESP.Distance = NewDrawing("Text")
    ESP.Distance.Size = 13
    ESP.Distance.Center = true
    ESP.Distance.Outline = true

    ESP.Stickman = {}

    for i = 1, 15 do

        local Line = NewDrawing("Line")
        Line.Thickness = 1.5

        table.insert(ESP.Stickman, Line)

    end

    ESPObjects[Player] = ESP
end

local function HideESP(ESP)

    ESP.Box.Visible = false
    ESP.Line.Visible = false
    ESP.Name.Visible = false
    ESP.Health.Visible = false
    ESP.Distance.Visible = false

    for _, Line in ipairs(ESP.Stickman) do
        Line.Visible = false
    end
end

local function RemoveESP(Player)

    local ESP = ESPObjects[Player]
    if not ESP then return end

    ESP.Box:Remove()
    ESP.Line:Remove()
    ESP.Name:Remove()
    ESP.Health:Remove()
    ESP.Distance:Remove()

    for _, Line in ipairs(ESP.Stickman) do
        Line:Remove()
    end

    ESPObjects[Player] = nil
end

--====================================================
-- STICKMAN BONES
--====================================================

local R15Bones = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

local R6Bones = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
}

local function UpdateStickman(Character, ESP, Camera)

    local Bones = Character:FindFirstChild("Torso")
        and R6Bones or R15Bones

    for i, Line in ipairs(ESP.Stickman) do

        Line.Visible = false

        local Pair = Bones[i]

        if Pair then

            local Part1 = Character:FindFirstChild(Pair[1])
            local Part2 = Character:FindFirstChild(Pair[2])

            if Part1 and Part2 then

                local Pos1, Visible1 =
                    Camera:WorldToViewportPoint(Part1.Position)

                local Pos2, Visible2 =
                    Camera:WorldToViewportPoint(Part2.Position)

                if Visible1 and Visible2 then

                    Line.From = Vector2.new(Pos1.X, Pos1.Y)
                    Line.To = Vector2.new(Pos2.X, Pos2.Y)

                    Line.Color = ESPSettings.Color
                    Line.Visible = true
                end
            end
        end
    end
end

--====================================================
-- UPDATE ESP
--====================================================

local function UpdateESP(Player, ESP, Camera)

    if not ESPSettings.Enabled then
        HideESP(ESP)
        return
    end

    local Character = Player.Character

    if not Character then
        HideESP(ESP)
        return
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Root or Humanoid.Health <= 0 then
        HideESP(ESP)
        return
    end

    local MyCharacter = LocalPlayer.Character
    local MyRoot = MyCharacter
        and MyCharacter:FindFirstChild("HumanoidRootPart")

    if not MyRoot then
        HideESP(ESP)
        return
    end

    local Distance = (MyRoot.Position - Root.Position).Magnitude

    if Distance > ESPSettings.MaxDistance then
        HideESP(ESP)
        return
    end

    local RootScreen, Visible =
        Camera:WorldToViewportPoint(Root.Position)

    if not Visible then
        HideESP(ESP)
        return
    end

    local HeadScreen = Camera:WorldToViewportPoint(
        Root.Position + Vector3.new(0, 3, 0)
    )

    local FootScreen = Camera:WorldToViewportPoint(
        Root.Position - Vector3.new(0, 3, 0)
    )

    local Height = math.abs(HeadScreen.Y - FootScreen.Y)
    local Width = Height / 2

    local BoxX = RootScreen.X - Width / 2
    local BoxY = RootScreen.Y - Height / 2

    -- BOX

    ESP.Box.Visible = ESPSettings.Box
    ESP.Box.Position = Vector2.new(BoxX, BoxY)
    ESP.Box.Size = Vector2.new(Width, Height)
    ESP.Box.Color = ESPSettings.Color

    -- LINE

    ESP.Line.Visible = ESPSettings.Line

    ESP.Line.From = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y
    )

    ESP.Line.To = Vector2.new(
        RootScreen.X,
        RootScreen.Y
    )

    ESP.Line.Color = ESPSettings.Color

    -- NAME

    ESP.Name.Visible = ESPSettings.Name
    ESP.Name.Text = Player.Name

    ESP.Name.Position = Vector2.new(
        RootScreen.X,
        BoxY - 18
    )

    ESP.Name.Color = ESPSettings.Color

    -- HEALTH

    ESP.Health.Visible = ESPSettings.Health

    local HP = math.floor(Humanoid.Health)
    local MaxHP = math.floor(Humanoid.MaxHealth)

    ESP.Health.Text = "HP: " .. HP .. "/" .. MaxHP

    ESP.Health.Position = Vector2.new(
        RootScreen.X,
        BoxY + Height + 3
    )

    local Percent = math.clamp(
        Humanoid.Health / math.max(Humanoid.MaxHealth, 1),
        0,
        1
    )

    ESP.Health.Color = Color3.fromRGB(
        255 * (1 - Percent),
        255 * Percent,
        0
    )

    -- DISTANCE

    ESP.Distance.Visible = ESPSettings.Distance
    ESP.Distance.Text = math.floor(Distance) .. " studs"

    ESP.Distance.Position = Vector2.new(
        RootScreen.X,
        BoxY + Height + 18
    )

    ESP.Distance.Color = Color3.new(1, 1, 1)

    -- STICKMAN

    if ESPSettings.Stickman then

        UpdateStickman(Character, ESP, Camera)

    else

        for _, Line in ipairs(ESP.Stickman) do
            Line.Visible = false
        end
    end
end

