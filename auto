--====================================================
-- PLAYER / TELEPORT SYSTEM
--====================================================

local SelectedPlayer = nil
local AutoTPEnabled = false
local AutoTPSession = 0
local TPDelay = 0.3

local function GetPlayerList()
    local List = {}

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            table.insert(List, Player.Name)
        end
    end

    table.sort(List)
    return List
end

local function GetSelectedPlayer()
    if not SelectedPlayer then
        return nil
    end

    return Players:FindFirstChild(SelectedPlayer)
end

local function TeleportToPlayer()
    local Target = GetSelectedPlayer()

    if not Target then
        return false, "Player tidak ditemukan"
    end

    local MyCharacter = LocalPlayer.Character
    local TargetCharacter = Target.Character

    if not MyCharacter or not TargetCharacter then
        return false, "Character belum tersedia"
    end

    local MyRoot = MyCharacter:FindFirstChild("HumanoidRootPart")
    local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")

    if not MyRoot or not TargetRoot then
        return false, "HumanoidRootPart tidak ditemukan"
    end

    local Success = pcall(function()
        MyRoot.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 3)
    end)

    if Success then
        return true, "Teleport ke " .. Target.Name
    end

    return false, "Teleport gagal"
end

