Global.FishFarmCleanup = function()

    Destroyed = true
    FarmEnabled = false
    FarmSession = FarmSession + 1

    -- stop auto tp if running
    AutoTPEnabled = false
    AutoTPSession = (AutoTPSession or 0) + 1

    for _, Connection in ipairs(Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    for Player in pairs(ESPObjects) do
        RemoveESP(Player)
    end

end

