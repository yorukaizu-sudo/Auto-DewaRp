local function BuyUdang(IsActive)

    for i = 1, 2 do

        if IsActive and not IsActive() then
            return
        end

        pcall(function()
            BuyEvent:InvokeServer("Udang", 50)
        end)

        task.wait(0.2)
    end
end

local function GiveFish()

