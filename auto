--====================================================

local function GetInventoryContainer()

    local InventoryUI = PlayerGui:FindFirstChild("InventoryUI")
    if not InventoryUI then return nil end

    local MainFrame = InventoryUI:FindFirstChild("MainFrame")
    if not MainFrame then return nil end

    local LeftPanel = MainFrame:FindFirstChild("LeftPanel")
    if not LeftPanel then return nil end

    local InventoryBox = LeftPanel:FindFirstChild("InventoryBox")
    if not InventoryBox then return nil end

    return InventoryBox:FindFirstChild("Container")
end

local function GetUdangAmount()

    local Container = GetInventoryContainer()
    if not Container then return nil end

    local Total = 0

    for _, Slot in ipairs(Container:GetChildren()) do

        if Slot.Name:match("^InvSlot_%d+$") then

            local ItemName = Slot:FindFirstChild("ItemName", true)
            local ItemAmount = Slot:FindFirstChild("ItemAmount", true)

            if ItemName and ItemAmount then

                if ItemName:IsA("TextLabel")
                    or ItemName:IsA("TextButton") then

                    local Name = string.upper(ItemName.Text)

                    if Name:find("UDANG", 1, true) then

                        local Amount = 0

                        if ItemAmount:IsA("TextLabel")
                            or ItemAmount:IsA("TextButton") then

                            Amount = tonumber(
                                ItemAmount.Text:match("%d+")
                            ) or 0

                        end

                        Total = Total + Amount

                    end
                end
            end
        end
    end

    return Total
end

