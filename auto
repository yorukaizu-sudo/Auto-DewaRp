    CurrentValue = false,
    Flag = "AutoTPPlayer",

    Callback = function(Value)
        AutoTPEnabled = Value
        AutoTPSession = AutoTPSession + 1

        local Session = AutoTPSession

        if Value then
            if not GetSelectedPlayer() then
                AutoTPEnabled = false

                Rayfield:Notify({
                    Title = "Auto TP",
                    Content = "Pilih player terlebih dahulu!",
                    Duration = 4,
                    Image = 4483362458
                })

                return
            end

            task.spawn(function()
                while AutoTPEnabled
                    and AutoTPSession == Session
                    and not Destroyed do

                    local Target = GetSelectedPlayer()

                    if not Target or not Target.Character then
                        -- target left or no character; stop auto tp
                        AutoTPEnabled = false
                        break
                    end

                    local MyChar = LocalPlayer.Character
                    local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")
                    local TargetRoot = Target.Character and Target.Character:FindFirstChild("HumanoidRootPart")

                    if MyRoot and TargetRoot then
                        pcall(function()
                            MyRoot.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 3)
                        end)
                    end

                    task.wait(TPDelay)
                end
            end)
        end

        Rayfield:Notify({
            Title = "Auto TP",
            Content = Value and "Auto TP Enabled" or "Auto TP Disabled",
            Duration = 3,
            Image = 4483362458
        })
    end
})

