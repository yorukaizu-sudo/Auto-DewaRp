        hookPosition = FishData.hookPosition,
        name = SelectedFish,
        rarity = FishData.rarity,
        weight = FishData.weight
    }

    pcall(function()
        FishEvent:FireServer(Data)
    end)

end

local function SellAll()

    pcall(function()
        SellEvent:InvokeServer("SellAll", "All")
    end)

end

--====================================================
-- AUTO FARM
--====================================================

local function StartFarm(Session)

    local NoDecrease = 0

    local function IsActive()
        return FarmEnabled
            and FarmSession == Session
            and not Destroyed
    end

    while IsActive() do

        local Amount = GetUdangAmount()

        if Amount == nil then

            task.wait(1)

        elseif Amount <= 0 then

            SellAll()

            task.wait(0.5)

            if not IsActive() then
                break
            end

            BuyUdang(IsActive)

            NoDecrease = 0

            task.wait(0.5)

        else

            GiveFish()

            task.wait(FarmDelay)

            if not IsActive() then
                break
            end

            local NewAmount = GetUdangAmount()

            if NewAmount ~= nil then

                if NewAmount < Amount then

                    NoDecrease = 0

                else

                    NoDecrease = NoDecrease + 1

                end

                if NoDecrease >= MaxNoDecrease then

                    SellAll()

                    task.wait(0.5)

                    if not IsActive() then
                        break
                    end

                    local CurrentAmount = GetUdangAmount()

                    if CurrentAmount == 0 then
                        BuyUdang(IsActive)
                    end

                    NoDecrease = 0

                    task.wait(0.5)

                end
            end
        end
    end
end

